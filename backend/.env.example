# --- Core ---
PORT=8080
NODE_ENV=production

# --- LLM (Groq — free tier, no credit card required, primary provider) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-20b
# Used only for image-upload/vision requests — see comment in config.ts
# for why this specific model is needed (gpt-oss models don't do vision).
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# --- LLM fallback (OpenRouter — used automatically if Groq fails/quota) ---
# Optional. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Postgres ---
DATABASE_URL=postgresql://user:password@localhost:5432/amsa_ai

# --- Redis (session/cache) ---
REDIS_URL=redis://localhost:6379

# --- Vector DB (optional, for real semantic search — Pinecone example) ---
PINECONE_API_KEY=xxxxxxxx
PINECONE_INDEX=amsa-ai-kb
PINECONE_ENV=us-east-1

# --- Web search (Tavily — optional, free tier: 1,000 searches/month, no card) ---
# Get a key at https://tavily.com — leave blank to disable web search entirely
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Web search fallback (Serper — optional, real Google results) ---
# Only used if Tavily is unconfigured or fails. Free tier is a one-time
# 2,500 queries (not monthly), no card required. Get a key at serper.dev
SERPER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Image generation fallback (Hugging Face — optional) ---
# Pollinations is the primary image generator (no key needed). This key
# only matters if Pollinations is down — leave blank to skip the fallback.
# Get a key at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Security ---
JWT_SECRET=change_this_to_a_long_random_string
ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:5173
