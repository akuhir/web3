# --- Core ---
PORT=8080
NODE_ENV=production

# --- LLM (Groq — free tier, no credit card required, primary provider) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant

# --- LLM fallback (OpenRouter — used automatically if Groq fails/quota) ---
# Optional. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Postgres ---
DATABASE_URL=postgresql://user:password@localhost:5432/amsa_ai

# --- Redis (session/cache) ---
REDIS_URL=redis://localhost:6379

# --- Vector DB (optional, for real semantic search — Pinecone example) ---
PINECONE_API_KEY=xxxxxxxx
PINECONE_INDEX=amsa-ai-kb
PINECONE_ENV=us-east-1

# --- Web search (Tavily — optional, free tier: 1,000 searches/month, no card) ---
# Get a key at https://tavily.com — leave blank to disable web search entirely
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Security ---
JWT_SECRET=change_this_to_a_long_random_string
ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:5173
